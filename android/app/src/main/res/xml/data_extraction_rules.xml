<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the knowledge map, chats and settings are backed up and moved to a new phone;
     the encrypted API keys are not (their Keystore key cannot move with them), so they are entered again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
