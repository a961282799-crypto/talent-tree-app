{
  "name": "talent-tree-app",
  "version": "1.2.1",
  "private": true,
  "description": "每个知识点，都连着另一个知识点。学习天赋树：AI 帮你理清前置知识，学会一个点亮一个。Android / iOS App。",
  "author": "Tao",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "sync": "vite build && cap sync",
    "android": "vite build && cap sync android && cap open android",
    "ios": "vite build && cap sync ios && cap open ios",
    "assets": "capacitor-assets generate --android --ios --iconBackgroundColor '#141a2e' --iconBackgroundColorDark '#141a2e' --splashBackgroundColor '#ffffff' --splashBackgroundColorDark '#141a2e'",
    "build:preview": "vite build --mode preview --outDir dist-preview"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.7"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "dompurify": "^3.4.17",
    "katex": "^0.19.1",
    "marked": "^18.1.3",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
